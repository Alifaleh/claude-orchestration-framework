# Workspace session config — copy to .env (gitignored) and fill in.
# .env is per-machine and NEVER committed.

# Git identity for THIS machine in THIS workspace (used for commits and gh operations here):
GIT_USER_NAME=
GIT_USER_EMAIL=
GITHUB_USERNAME=

# Role of Claude sessions on THIS machine for THIS project:
#   team_leader — reviews, accepts/rejects, and merges PRs; bumps submodule pins; triggers
#                 deploys where the project has them; may commit workspace docs directly
#   team_member — all code work via feature branch + PR; never merges, never pushes main;
#                 checks for rejected/changes-requested PRs at session start and fixes them first
WORKSPACE_ROLE=team_member

# Crew mode: orchestration fan-out for Claude sessions in this workspace (not a secret).
#   solo — one engineer lane, serial beats, one combined top-tier review per wave (DEFAULT
#          when absent) · duo — two file-disjoint lanes · full — 3-5 lanes, per-beat reviews.
# Switched only when the user tells the session to. Security-critical (hard-trigger) beats
# are never crew-scoped: top-tier engineer + per-beat review in every mode.
CREW_MODE=solo

# Project-specific keys go below — names only in docs/code, values only here.
# .env is this project's CREDENTIAL STORE: when the user provides creds (API keys, DB
# passwords, tokens), Claude saves them in .env in the same session for future sessions to
# use — never committed, never printed. Each key's NAME (not value) gets documented here in
# example.env and in ONBOARDING.md §3.
